SERVER_PORT=8080
# Local dev origins by default. In production (Render), add the deployed
# credit-web domain too, e.g.:
# APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,https://fyatest.cmescorcia.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# Base URL of credit-web, used to build the "ver detalle" link in the
# credit-registered email. In production: https://fyatest.cmescorcia.com
APP_FRONTEND_BASE_URL=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRATION_MINUTES=60
DEMO_USER_USERNAME=demo
DEMO_USER_PASSWORD_HASH=$2a$10$replace-with-bcrypt-hash
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=service-account@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_HEALTH_TIMEOUT_SECONDS=15
RESEND_API_KEY=re_placeholder
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=creditos@example.com
RESEND_FROM_NAME=Fya Social Capital
CREDIT_NOTIFICATION_EMAIL=fyasocialcapital@gmail.com
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CREATE_CREDIT_PER_MINUTE=20
RATE_LIMIT_LIST_CREDITS_PER_MINUTE=60
EMAIL_WORKER_ENABLED=false
EMAIL_WORKER_FIXED_DELAY_MS=10000
EMAIL_WORKER_BATCH_SIZE=10
EMAIL_WORKER_MAX_ATTEMPTS=3
